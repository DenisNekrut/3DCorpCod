{
  "name": "3dcorpcod",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "electron .",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:win:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.179.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.3dcorpcod.studio",
    "productName": "3DCorpCod",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asar": true,
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "artifactName": "3DCorpCod-Portable-${version}.${ext}"
    },
    "portable": { "artifactName": "3DCorpCod-Portable-${version}.${ext}" }
  }
}
